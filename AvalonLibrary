	local function clampWindowPosition(position)
		local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800, 600)
		local size = Win.Main.AbsoluteSize
		local targetX = viewport.X * position.X.Scale + position.X.Offset
		local targetY = viewport.Y * position.Y.Scale + position.Y.Offset
		targetX = math.clamp(targetX, -size.X / 2 + 35, viewport.X - size.X / 2 - 35)
		targetY = math.clamp(targetY, -size.Y / 2 + 20, viewport.Y - size.Y / 2 - 20)
		return UDim2.new(position.X.Scale, targetX - viewport.X * position.X.Scale,
			position.Y.Scale, targetY - viewport.Y * position.Y.Scale)
	end

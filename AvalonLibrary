					fullWidth = opts.FullWidth,
					onChange = opts.Callback,
				})
			end
			function sectionApi:AddDropdown(opts)
				opts = opts or {}
				local defaultIndex = opts.DefaultIndex
				if defaultIndex == nil and type(opts.Default) == "number" then
					defaultIndex = opts.Default
				end
				local defaultSelected = nil
				if opts.Multi and type(opts.Default) == "table" then
					defaultSelected = opts.Default
				end
				if defaultIndex == nil and type(opts.Default) == "string" and type(opts.Options) == "table" then
					for i, option in ipairs(opts.Options) do
						if option == opts.Default then
							defaultIndex = i
							break
						end
					end
				end
				return push({
					type = "Dropdown",
					label = opts.Text,
					options = opts.Options or {},
					defaultIndex = defaultIndex or 1,
					defaultSelected = defaultSelected,
					multi = opts.Multi or false,
					placeholder = opts.Placeholder or "Выбрать",

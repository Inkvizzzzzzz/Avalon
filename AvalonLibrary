			local targetColumn
			if column == "left" then
				targetColumn = leftColumn
			elseif column == "right" then
				targetColumn = rightColumn
			else
				nextColumn = nextColumn + 1
				targetColumn = (nextColumn % 2 == 1) and leftColumn or rightColumn
			end
			local card = CreateCard(targetColumn, title, options)
			task.defer(updatePageHeight)
			return card
		end


	Connect(addButton.Activated, function() addRow(selected) end)

	if UserInputService.KeyboardEnabled then
		for featureName, keyName in pairs(Win.keyboardBinds) do
			if Win.featureToggleSetters[featureName] and type(keyName) == "string" then
				local ok, keyCode = pcall(function() return Enum.KeyCode[keyName] end)

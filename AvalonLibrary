			TextSize = 10,
			Font = Enum.Font.GothamBold,
			AutoButtonColor = false,
			Parent = row,
		})
		Create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = deleteButton })
		rows[featureName] = row
		Connect(deleteButton.Activated, function()
			RemoveQuickBind(featureName)
			if rows[featureName] then rows[featureName]:Destroy() end
			rows[featureName] = nil

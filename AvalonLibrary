	elseif definition.type == "Toggle" then
		api = MakeToggle(control, definition)
	elseif definition.type == "Slider" then
		api = MakeSlider(control, definition)
	elseif definition.type == "Dropdown" then
		api = MakeDropdown(control, definition)
	elseif definition.type == "Button" then
		local action = Create("TextButton", {
			Size = UDim2.new(1, 0, 0, 26),

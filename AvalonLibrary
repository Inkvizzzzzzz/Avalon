			local column, options
			if type(columnOrOptions) == "table" then
				options = columnOrOptions
			elseif type(columnOrOptions) == "string" then
				column = columnOrOptions
			end
			local card = addCard(title, column, options)
			local sectionApi = {
				Title = title,
				Card = card,
			}
			local rowCounter = 0
			local function push(definition)
				rowCounter = rowCounter + 1
				if definition.saveKey == nil and definition.noSave ~= true
					and (definition.type == "Toggle" or definition.type == "Slider" or definition.type == "Dropdown") then
					local labelPart = definition.label or definition.bindName or definition.placeholder or ""
					labelPart = tostring(labelPart):gsub("\n", " ")
					definition.saveKey = title .. "/" .. rowCounter .. "/" .. labelPart
				end
				local api = CreateControlRow(card, definition)
				task.defer(updatePageHeight)
				return api
			end

			function sectionApi:AddToggle(opts)
				opts = opts or {}
				return push({
					type = "Toggle",
					label = opts.Text,
					default = opts.Default,
					saveKey = opts.Save,
					noSave = opts.NoSave,
					bindName = opts.Bind,
					onChange = opts.Callback,
				})
			end
			function sectionApi:AddSlider(opts)
				opts = opts or {}
				local sliderDefault = opts.Default
				if sliderDefault == nil then sliderDefault = opts.Min or 0 end
				return push({
					type = "Slider",
					label = opts.Text,
					min = opts.Min or 0,
					max = opts.Max or 100,

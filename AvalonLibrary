local function ApplyTheme(name)
	if not Win.ScreenGui or not Win.ScreenGui.Parent then return end
	if not Library.Themes[name] then name = "Зеленая" end
	Library.Config.theme = name
	Library:SaveConfig()
	local palette = Library.Themes[name]
	local accent, secondary = palette[1], palette[2]
	Library.Colors.accent = accent
	Library.Colors.secondary = secondary
	ActiveColor = accent
	local sequence = ColorSequence.new({
		ColorSequenceKeypoint.new(0, secondary),
		ColorSequenceKeypoint.new(0.34, accent),
		ColorSequenceKeypoint.new(0.62, secondary),
		ColorSequenceKeypoint.new(1, accent),
	})
	Win.BorderGradient.Color = sequence
	Win.LauncherGradient.Color = sequence
	Win.Shimmer.BackgroundColor3 = accent
	Win.ShimmerGradient.Color = ColorSequence.new(secondary, accent)
	for _, object in ipairs(Win.themeObjects.accent) do
		if object and object.Parent then object.BackgroundColor3 = accent end
	end
	for _, refresh in ipairs(Win.themeRefreshers) do
		refresh()
	end
end

local function ClosePopup()
	if Win.activePopup then
		Win.activePopup:Destroy()
		Win.activePopup = nil
	end
	Win.activePopupButton = nil
end

local function ToggleMainMenu()
	Win.menuTransitionId = Win.menuTransitionId + 1
	local transitionId = Win.menuTransitionId
	local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800, 600)
	if Win.menuTween then pcall(function() Win.menuTween:Cancel() end); Win.menuTween = nil end
	if Win.menuIsOpen then
		Win.menuIsOpen = false
		local hidden = UDim2.new(Win.menuRestPosition.X.Scale, Win.menuRestPosition.X.Offset, Win.menuRestPosition.Y.Scale, Win.menuRestPosition.Y.Offset + viewport.Y + Win.Main.AbsoluteSize.Y)
		Win.menuTween = AnimateMenu(Win.Main, { Position = hidden }, 0.9)
		AnimateMenu(Win.MenuBlur, { Size = 0 }, 0.4)
		task.delay(0.42, function()
			if not Cleanup.alive then return end
			if not Win.menuIsOpen then Win.MenuBlur.Enabled = false end
		end)
		task.delay(0.91, function()
			if not Cleanup.alive then return end
			if transitionId == Win.menuTransitionId then
				Win.Main.Visible = false
			end
			if not Win.menuIsOpen then Win.MenuBlur.Enabled = false end
		end)
		if Win.activePopup then ClosePopup() end
	else
		Win.menuIsOpen = true
		local target = Win.menuRestPosition
		local hidden = UDim2.new(target.X.Scale, target.X.Offset, target.Y.Scale, target.Y.Offset + viewport.Y + Win.Main.AbsoluteSize.Y)
		Win.Main.Position = hidden
		Win.Main.Visible = true
		Win.MenuBlur.Enabled = true
		Win.MenuBlur.Size = 0
		AnimateMenu(Win.MenuBlur, { Size = 28 }, 0.9)
		Win.menuTween = AnimateMenu(Win.Main, { Position = target }, 0.9)
	end
end

local function SwitchTab(name)
	if Win.activeTab == name or not Win.tabs[name] then return end
	ClosePopup()
	if Win.activeTab then
		Win.tabs[Win.activeTab].page.Visible = false
		Win.tabs[Win.activeTab].button.BackgroundColor3 = Color3.fromRGB(31, 31, 36)
		local ic = Win.tabIconMap[Win.tabs[Win.activeTab].button]
		if ic then ic.ImageColor3 = Library.Colors.muted end
	end
	Win.activeTab = name
	local tab = Win.tabs[name]
	tab.page.Visible = true
	tab.page.Position = UDim2.fromOffset(6, 16)
	Animate(tab.page, { Position = UDim2.fromOffset(6, 8) }, 0.2)
	tab.button.BackgroundColor3 = Library.Colors.controlHover
	local ic2 = Win.tabIconMap[tab.button]
	if ic2 then ic2.ImageColor3 = Library.Colors.text end
	Win.RightPanel.CanvasPosition = Vector2.new(0, 0)
	task.defer(function()
		if Win.tabs[name] and Win.tabs[name].page and Win.tabs[name].page.Visible then
			Win.RightPanel.CanvasSize = UDim2.fromOffset(0, 24 + math.max(1, Win.tabs[name].page.AbsoluteSize.Y))
		end
	end)
end


local function isFiniteNumber(value)
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function copyTable(source)
	local result = {}
	for key, value in pairs(source) do result[key] = value end
	return result
end

local VALID_THEMES = {}

local function LoadConfigFile()
	Library.Config = defaultConfig()
	table.clear(VALID_THEMES)
	for name in pairs(Library.Themes) do VALID_THEMES[name] = true end
	if not (writefile and readfile and isfile) then return end
	pcall(function()
		local path = Library.ConfigName .. ".json"
		if isfile(path) then
			local decoded = HttpService:JSONDecode(readfile(path))
			if type(decoded) == "table" and decoded.version == Library.CONFIG_VERSION then
				for key, value in pairs(decoded) do Library.Config[key] = value end
			else
				Library.Config._reset = true
			end
		end
	end)

	local configNeedsSave = Library.Config._reset == true
	if type(Library.Config.theme) ~= "string" or not VALID_THEMES[Library.Config.theme] then
		Library.Config.theme = "Зеленая"
		configNeedsSave = true
	end
	if type(Library.Config.features) ~= "table" then
		Library.Config.features = {}
		configNeedsSave = true
	end
	if type(Library.Config.menu) ~= "table"
		or not isFiniteNumber(Library.Config.menu.xScale) or not isFiniteNumber(Library.Config.menu.xOffset)
		or not isFiniteNumber(Library.Config.menu.yScale) or not isFiniteNumber(Library.Config.menu.yOffset)
		or math.abs(Library.Config.menu.xOffset) > 2500 or math.abs(Library.Config.menu.yOffset) > 2500
		or Library.Config.menu.xScale < -0.2 or Library.Config.menu.xScale > 1.2
		or Library.Config.menu.yScale < -0.2 or Library.Config.menu.yScale > 1.2
		or (Library.Config.menu.xScale == 0 and Library.Config.menu.yScale == 0 and Library.Config.menu.xOffset == 0 and Library.Config.menu.yOffset == 0) then
		Library.Config.menu = copyTable(DEFAULT_MENU)
		configNeedsSave = true
	end
	if type(Library.Config.keyboardBinds) ~= "table" then
		Library.Config.keyboardBinds = {}
		configNeedsSave = true
	else
		local sanitizedBinds = {}
		local bindsChanged = false
		for featureName, keyName in pairs(Library.Config.keyboardBinds) do
			local valid = type(featureName) == "string" and type(keyName) == "string"
			if valid then
				local ok, keyCode = pcall(function() return Enum.KeyCode[keyName] end)
				valid = ok and keyCode ~= nil
			end
			if valid then
				sanitizedBinds[featureName] = keyName
			else
				bindsChanged = true
			end
		end
		if bindsChanged then
			Library.Config.keyboardBinds = sanitizedBinds
			configNeedsSave = true
		end
	end
	Library.Config._reset = nil
	if configNeedsSave then Library:SaveConfig() end
end

local saveScheduled = false

function Library:SaveConfig()
	if writefile then
		pcall(function()
			Library.Config.version = Library.CONFIG_VERSION
			writefile(Library.ConfigName .. ".json", HttpService:JSONEncode(Library.Config))
		end)
	end
end

local function ScheduleSave()
	if saveScheduled then return end
	saveScheduled = true
	task.delay(0.6, function()
		if not Cleanup.alive then return end
		saveScheduled = false
		Library:SaveConfig()
	end)
end

function Library:SetFeature(key, value)
	if key == nil then return end
	Library.Config.features[key] = value
	ScheduleSave()
end

function Library:GetFeature(key)
	if key == nil then return nil end
	return Library.Config.features[key]
end

local function SaveFeature(key, value)
	Library:SetFeature(key, value)
end

local function LoadFeature(key)
	return Library:GetFeature(key)
end

local function Create(className, properties)
	local object = Instance.new(className)
	for property, value in pairs(properties or {}) do
		object[property] = value
	end
	return object
end

local function Animate(object, properties, duration)
	local tween = TweenService:Create(object, TweenInfo.new(duration or 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties)
	tween:Play()
	return tween
end

local function AnimateMenu(object, properties, duration)
	local tween = TweenService:Create(object, TweenInfo.new(duration or 0.82, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), properties)
	tween:Play()
	return tween
end

local function GetSafeGuiParent()
	local ok, res = pcall(function()
		if gethui then
			local hui = gethui()
			if hui and (hui:IsA("ScreenGui") or hui:IsA("Folder") or hui:IsA("CoreGui") or hui.Parent) then
				return hui
			end
		end
		if cloneref then
			local cg = cloneref(game:GetService("CoreGui"))
			if cg then return cg end
		end
		return game:GetService("CoreGui")
	end)
	if ok and res then return res end

	local lp = Players.LocalPlayer
	if lp then
		local pg = lp:FindFirstChildOfClass("PlayerGui") or lp:FindFirstChild("PlayerGui")
		if pg then return pg end
		return lp:WaitForChild("PlayerGui", 5)
	end
	return nil
end

local OLD_GUI_NAMES = { "AvalonLibHub", "AvalonLibLauncher", "AvalonHub", "AvalonLauncher", "AvalonBackdrop" }

local function CleanupOldGuis(parent)
	if not parent then return end
	pcall(function()
		for _, g in ipairs(parent:GetChildren()) do
			if g:IsA("ScreenGui") then
				for _, name in ipairs(OLD_GUI_NAMES) do
					if g.Name == name then
						g:Destroy()
						break
					end
				end
			end
		end
	end)
end


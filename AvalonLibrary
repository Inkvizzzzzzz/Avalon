		local function updatePageHeight()
			local height
			if customHeight then
				height = customHeight
			else
				height = math.max(leftLayout.AbsoluteContentSize.Y, rightLayout.AbsoluteContentSize.Y)
			end
			page.Size = UDim2.new(1, -12, 0, math.max(1, height))

	local function ensureGuiAlive()
		if not Cleanup.alive then return end
		local targetParent = GetSafeGuiParent() or Win.GuiParent
		if not Win.ScreenGui or not Win.ScreenGui.Parent or Win.ScreenGui.Parent ~= targetParent then
			pcall(function() Win.ScreenGui.Parent = targetParent end)
		end
		if Win.ScreenGui and not Win.ScreenGui.Enabled then pcall(function() Win.ScreenGui.Enabled = true end) end
		if Win.ScreenGui and Win.ScreenGui.ResetOnSpawn then pcall(function() Win.ScreenGui.ResetOnSpawn = false end) end
		if not Win.LauncherGui or not Win.LauncherGui.Parent or Win.LauncherGui.Parent ~= targetParent then
			pcall(function() Win.LauncherGui.Parent = targetParent end)
		end
		if Win.LauncherGui and not Win.LauncherGui.Enabled then pcall(function() Win.LauncherGui.Enabled = true end) end
		pcall(function()
			if Win.PopupLayer and Win.PopupLayer.Parent ~= Win.ScreenGui then Win.PopupLayer.Parent = Win.ScreenGui end
			if Win.BindButtonHolder and Win.BindButtonHolder.Parent ~= Win.ScreenGui then Win.BindButtonHolder.Parent = Win.ScreenGui end
			if Win.Main and Win.Main.Parent ~= Win.ScreenGui then Win.Main.Parent = Win.ScreenGui end
			if Win.LauncherBorder and Win.LauncherBorder.Parent ~= Win.LauncherGui then Win.LauncherBorder.Parent = Win.LauncherGui end
		end)
		pcall(function()
			if not Win.MenuBlur or not Win.MenuBlur.Parent then
				local old = Lighting:FindFirstChild("AvalonMenuBlur")
				if old then old:Destroy() end
				Win.MenuBlur = Create("BlurEffect", {
					Name = "AvalonMenuBlur",
					Size = Win.menuIsOpen and 28 or 0,
					Enabled = Win.menuIsOpen,
					Parent = Lighting,
				})
			end
		end)
	end
	Connect(RunService.Heartbeat, function() pcall(ensureGuiAlive) end)
	task.spawn(function()
		while Cleanup.alive and task.wait(2) do
			pcall(ensureGuiAlive)
		end
	end)
	for _, gui in ipairs({ Win.ScreenGui, Win.LauncherGui }) do
		pcall(function()
			Connect(gui:GetPropertyChangedSignal("Parent"), function()
				task.defer(function() if Cleanup.alive then pcall(ensureGuiAlive) end end)
			end)
			Connect(gui.AncestryChanged, function(_, p)
				if p == nil then
					task.defer(function() if Cleanup.alive then pcall(ensureGuiAlive) end end)
				end
			end)
		end)
	end
	pcall(function()
		Connect(Win.PlayerGui.ChildRemoved, function(child)
			if child == Win.ScreenGui or child == Win.LauncherGui then
				task.defer(function() if Cleanup.alive then pcall(ensureGuiAlive) end end)
			end
		end)
	end)

	
	SwitchTab("Игрок")
	ApplyTheme(options.Theme or Library.Config.theme or "Зеленая")
	pcall(function()
		Win.menuIsOpen = true
		Win.Main.Visible = true
		Win.LauncherBorder.Visible = true
		if Win.MenuBlur then
			Win.MenuBlur.Enabled = true
			Win.MenuBlur.Size = 28
		end
	end)

	return windowApi
end

function Library:CreateWindow(options)
	Library:_Reset()
	Cleanup.alive = true
	Library.ConfigName = tostring((options or {}).ConfigName or "AvalonLib")
	LoadConfigFile()
	return BuildWindow(options or {})
end

function Library:_Reset()
	
	
	
	Cleanup.alive = false
	saveScheduled = false
	pcall(function()
		if Library.OnDestroy then Library.OnDestroy() end
	end)
	for _, connection in ipairs(Cleanup.connections) do
		pcall(function() connection:Disconnect() end)
	end
	table.clear(Cleanup.connections)
	if Win.ScreenGui then pcall(function() Win.ScreenGui:Destroy() end) end
	if Win.LauncherGui then pcall(function() Win.LauncherGui:Destroy() end) end
	local blur = Lighting:FindFirstChild("AvalonMenuBlur")
	if blur then pcall(function() blur:Destroy() end) end
	Win = {}
	ActiveColor = Library.Colors.accent
	activeSliderToken = nil
	Library.Config = defaultConfig()
	Library.ConfigName = "AvalonLib"
end

function Library:Destroy()
	Library:_Reset()
	if SharedEnv.AvalonLibraryCleanup == Library._cleanupHandle then
		SharedEnv.AvalonLibraryCleanup = nil
	end
end

function Library:SetTheme(name)
	if Win.windowApi then
		ApplyTheme(name)
	end
end

Library._cleanupHandle = function()
	Library:Destroy()
end
SharedEnv.AvalonLibraryCleanup = Library._cleanupHandle

return Library

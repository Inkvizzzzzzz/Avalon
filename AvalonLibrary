		})
		MakeToggle(holder, {
			default = options.Toggle.Default or false,
			onChange = options.Toggle.Callback,
			saveKey = title,
		})
	else
		local expanded = true
		local titleButton = Create("TextButton", {
			Size = UDim2.new(1, -26, 1, 0),
			BackgroundTransparency = 1,
			Text = title,
			TextColor3 = Library.Colors.text,
			TextSize = 14,
			Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			Parent = header,
		})
		local arrow = Create("ImageButton", {
			Size = UDim2.fromOffset(18, 18),
			Position = UDim2.new(1, -20, 0, 2),
			BackgroundTransparency = 1,
			Image = "rbxassetid://4509268602",
			Parent = header,
		})
		local animationId = 0
		local function setExpanded(value)
			animationId = animationId + 1
			local thisAnimation = animationId
			local startHeight = card.AbsoluteSize.Y
			expanded = value
			arrow.Image = expanded and "rbxassetid://4509268602" or "rbxassetid://4509267080"
			card.AutomaticSize = Enum.AutomaticSize.None
			card.Size = UDim2.new(1, 0, 0, startHeight)
			if expanded then
				for _, child in ipairs(card:GetChildren()) do
					if child:IsA("GuiObject") and child ~= header then child.Visible = true end
				end
			end
			task.defer(function()
				task.defer(function()
					if not card.Parent or thisAnimation ~= animationId then return end
					local targetHeight = expanded and layout.AbsoluteContentSize.Y + 18 or 40
					Animate(card, { Size = UDim2.new(1, 0, 0, targetHeight) }, 0.28)
					task.delay(0.29, function()
						if not card.Parent or thisAnimation ~= animationId then return end
						if not expanded then
							for _, child in ipairs(card:GetChildren()) do
								if child:IsA("GuiObject") and child ~= header then child.Visible = false end
							end
						end
						card.AutomaticSize = Enum.AutomaticSize.Y
					end)
				end)
			end)
		end
		Connect(titleButton.Activated, function() setExpanded(not expanded) end)
		Connect(arrow.Activated, function() setExpanded(not expanded) end)
	end

	return card
end


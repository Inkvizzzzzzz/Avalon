local function MakeToggle(parent, definition)
	local toggle = Create("TextButton", {
		Size = UDim2.fromOffset(42, 20),
		Position = UDim2.new(0, 0, 0.5, -10),
		BackgroundColor3 = Library.Colors.control,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = parent,
	})
	Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = toggle })
	local thumb = Create("Frame", {
		Size = UDim2.fromOffset(16, 16),
		Position = UDim2.fromOffset(2, 2),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = toggle,
	})
	Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = thumb })

	local value = definition.default == true

	local function setValue(newValue, callCallback)
		value = newValue
		if definition.bindName then
			Win.featureStates[definition.bindName] = value
			Win.refreshBindButtons()
		end
		Animate(toggle, { BackgroundColor3 = value and ActiveColor or Library.Colors.control })
		Animate(thumb, { Position = value and UDim2.fromOffset(24, 2) or UDim2.fromOffset(2, 2) })
		if callCallback then
			SaveFeature(definition.saveKey, value)
			if definition.onChange then definition.onChange(value) end
		end
	end

	setValue(value, false)
	do
		local saved = LoadFeature(definition.saveKey)
		if type(saved) == "boolean" and saved ~= value then
			task.defer(function()
				pcall(function() setValue(saved, true) end)
			end)
		end
	end
	AddThemeRefresher(function()
		if toggle.Parent then toggle.BackgroundColor3 = value and ActiveColor or Library.Colors.control end
	end)
	if definition.bindName then
		Win.featureToggleSetters[definition.bindName] = function(newValue)
			setValue(newValue, true)
		end
	end
	Connect(toggle.Activated, function() setValue(not value, true) end)

	return {
		SetValue = function(self, newValue, callCallback)
			setValue(newValue, callCallback ~= false)
		end,
		GetValue = function(self) return value end,
	}
end

local activeSliderToken = nil

local function MakeSlider(parent, definition)
	local sliderToken = {}
	local holder = Create("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Parent = parent })
	local valueLabel = Create("TextBox", {
		Size = UDim2.fromOffset(34, 22),
		Position = UDim2.new(1, -34, 0.5, -11),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		TextColor3 = Library.Colors.text,
		TextSize = 11,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = holder,
	})
	local knobDiameter = 18
	local track = Create("TextButton", {
		Size = UDim2.new(1, -38, 0, 24),
		Position = UDim2.new(0, 0, 0.5, -12),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = holder,
	})
	local rail = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 0.5, -3),
		BackgroundColor3 = Library.Colors.control,
		BorderSizePixel = 0,
		Parent = track,
	})
	Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = rail })
	local fill = Create("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Library.Colors.accent,
		BorderSizePixel = 0,
		Parent = rail,
	})
	table.insert(Win.themeObjects.accent, fill)
	Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })
	local knob = Create("Frame", {
		Size = UDim2.fromOffset(knobDiameter, knobDiameter),
		BackgroundColor3 = Color3.fromRGB(250, 250, 252),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = track,
	})
	Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })
	Create("UIStroke", { Color = Color3.fromRGB(180, 180, 188), Transparency = 0.35, Thickness = 1, Parent = knob })

	local value = definition.default
	if value == nil then value = definition.min or 0 end
	local pointer, moving = nil, false

	local function update(newValue, callCallback)
		value = math.clamp(newValue, definition.min, definition.max)
		local percent = (value - definition.min) / (definition.max - definition.min)
		local width = math.max(track.AbsoluteSize.X, knobDiameter)
		local travel = math.max(0, width - knobDiameter)
		local knobX = math.round(travel * percent)
		fill.Size = UDim2.fromOffset(math.round(knobX + knobDiameter / 2), 6)
		knob.Position = UDim2.fromOffset(knobX, math.round((24 - knobDiameter) / 2))
		valueLabel.Text = tostring(math.round(value))
		if callCallback then
			SaveFeature(definition.saveKey, value)
			if definition.onChange then definition.onChange(value) end
		end
	end

	local function setFromInput(input)
		local width = math.max(track.AbsoluteSize.X, knobDiameter)
		local travel = math.max(1, width - knobDiameter)
		local percent = math.clamp((input.Position.X - track.AbsolutePosition.X - knobDiameter / 2) / travel, 0, 1)
		update(definition.min + percent * (definition.max - definition.min), true)
	end

	Connect(track:GetPropertyChangedSignal("AbsoluteSize"), function()
		update(value, false)
	end)
	update(value, false)
	do
		local saved = LoadFeature(definition.saveKey)
		if type(saved) == "number" then
			task.defer(function()
				pcall(function() update(saved, true) end)
			end)
		end
	end
	Connect(valueLabel.FocusLost, function()
		local cleanText = valueLabel.Text:gsub(",", ".")
		local typedValue = tonumber(cleanText)
		if typedValue then
			update(typedValue, true)
		else
			update(value, false)
		end
	end)
	Connect(track.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			activeSliderToken = sliderToken
			moving, pointer = true, input
			setFromInput(input)
		end
	end)
	Connect(UserInputService.InputChanged, function(input)
		local isMouseMove = pointer and pointer.UserInputType == Enum.UserInputType.MouseButton1
			and input.UserInputType == Enum.UserInputType.MouseMovement
		if moving and activeSliderToken == sliderToken and (input == pointer or isMouseMove) then
			setFromInput(input)
		end
	end)
	Connect(UserInputService.InputEnded, function(input)
		if input == pointer then
			moving, pointer = false, nil
			if activeSliderToken == sliderToken then activeSliderToken = nil end
		end
	end)

	return {
		SetValue = function(self, newValue, callCallback)
			update(newValue, callCallback ~= false)
		end,
		GetValue = function(self) return value end,
	}
end

local function MakeDropdown(parent, definition)
	local choices = definition.options or {}
	local selected = math.clamp(definition.defaultIndex or 1, 1, math.max(#choices, 1))
	local selectedSet = {}
	if definition.multi then
		for _, option in ipairs(definition.defaultSelected or {}) do selectedSet[option] = true end
	end
	local function countSelected()
		local count = 0
		for _, isOn in pairs(selectedSet) do
			if isOn == true then count = count + 1 end
		end
		return count
	end
	local function multiButtonText()
		local count = countSelected()
		return count > 0 and (definition.placeholder or "Выбрать") .. " (" .. count .. ")" or (definition.placeholder or "Выбрать")
	end
	local buttonText = definition.multi and multiButtonText() or (choices[selected] or "—")
	local button = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.new(0, 0, 0.5, -13),
		BackgroundColor3 = Library.Colors.control,
		BorderSizePixel = 0,
		Text = buttonText,
		TextColor3 = Library.Colors.text,
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		TextTruncate = Enum.TextTruncate.AtEnd,
		AutoButtonColor = false,
		Parent = parent,
	})
	Create("UICorner", { CornerRadius = UDim.new(0, 5), Parent = button })
	local dropdownApi = {}

	do
		local saved = LoadFeature(definition.saveKey)
		if definition.multi and type(saved) == "table" then
			selectedSet = {}
			for _, option in ipairs(choices) do
				if saved[option] == true then
					selectedSet[option] = true
				end
			end
			button.Text = multiButtonText()
			task.defer(function()
				if not Cleanup.alive then return end
				pcall(function()
					if definition.onChange then definition.onChange(selectedSet) end
				end)
			end)
		elseif not definition.multi and type(saved) == "string" then
			for index, option in ipairs(choices) do
				if option == saved and index ~= selected then
					selected, button.Text = index, option
					task.defer(function()
						if not Cleanup.alive then return end
						pcall(function()
							if definition.onChange then definition.onChange(option, index) end
						end)
					end)
					break
				end
			end
		end
	end

	function dropdownApi:Refresh(newChoices, preferredValue)
		if type(newChoices) ~= "table" then return button.Text end
		local previousValue = not definition.multi and choices[selected] or nil
		choices = newChoices
		if definition.multi then
			local filtered = {}
			for _, option in ipairs(choices) do
				if selectedSet[option] then filtered[option] = true end
			end
			selectedSet = filtered
			button.Text = multiButtonText()
		else
			local wanted = preferredValue or previousValue
			selected = 1
			if wanted ~= nil then
				for index, option in ipairs(choices) do
					if option == wanted then
						selected = index
						break
					end
				end
			end
			selected = math.clamp(selected, 1, math.max(#choices, 1))
			button.Text = choices[selected] or "—"
		end
		ClosePopup()
		return button.Text
	end

	function dropdownApi:GetValue()
		if definition.multi then
			local out = {}
			for option, isOn in pairs(selectedSet) do
				if isOn == true then out[option] = true end
			end
			return out
		end
		return choices[selected]
	end

	function dropdownApi:SetValue(option)
		if definition.multi then return false end
		for index, item in ipairs(choices) do
			if item == option then
				selected, button.Text = index, option
				SaveFeature(definition.saveKey, option)
				if definition.onChange then definition.onChange(option, index) end
				return true
			end
		end
		return false
	end

	Connect(button.Activated, function()
		local wasThisButton = Win.activePopupButton == button
		if Win.activePopup then ClosePopup() end
		if wasThisButton then return end
		local pos = button.AbsolutePosition - Win.PopupLayer.AbsolutePosition
		local height = math.max(28, math.min(#choices * 28, 168))
		local popupSize = Win.PopupLayer.AbsoluteSize
		local popupX = math.clamp(pos.X, 4, math.max(4, popupSize.X - button.AbsoluteSize.X - 4))
		local popupY = pos.Y + button.AbsoluteSize.Y + 3
		if popupY + height > popupSize.Y - 4 then popupY = math.max(4, pos.Y - height - 3) end
		local list = Create("ScrollingFrame", {
			Size = UDim2.fromOffset(button.AbsoluteSize.X, height),
			Position = UDim2.fromOffset(popupX, popupY),
			BackgroundColor3 = Library.Colors.card,
			BorderSizePixel = 0,
			ScrollBarThickness = (#choices > 6) and 3 or 0,
			CanvasSize = UDim2.fromOffset(0, #choices * 28),
			ZIndex = 60,
			Parent = Win.PopupLayer,
		})
		Create("UICorner", { CornerRadius = UDim.new(0, 5), Parent = list })
		Create("UIStroke", { Color = Library.Colors.cardStroke, Thickness = 1, Parent = list })
		for index, option in ipairs(choices) do
			local optionButton = Create("TextButton", {
				Size = UDim2.new(1, 0, 0, 28),
				Position = UDim2.fromOffset(0, (index - 1) * 28),
				BackgroundColor3 = ((definition.multi and selectedSet[option]) or (not definition.multi and index == selected)) and Library.Colors.controlHover or Library.Colors.card,
				BorderSizePixel = 0,
				Text = option,
				TextColor3 = Library.Colors.text,
				TextSize = 12,
				Font = Enum.Font.Gotham,
				ZIndex = 61,
				Parent = list,
			})
			Connect(optionButton.Activated, function()
				if definition.multi then
					if selectedSet[option] then
						selectedSet[option] = nil
					else
						selectedSet[option] = true
					end
					optionButton.BackgroundColor3 = selectedSet[option] and Library.Colors.controlHover or Library.Colors.card
					button.Text = multiButtonText()
					SaveFeature(definition.saveKey, selectedSet)
					if definition.onChange then definition.onChange(selectedSet) end
				else
					selected, button.Text = index, option
					ClosePopup()
					SaveFeature(definition.saveKey, option)
					if definition.onChange then definition.onChange(option, index) end
				end
			end)
		end
		Win.activePopup = list
		Win.activePopupButton = button
	end)

	return dropdownApi
end

local function CreateQuickBind(featureName, keyCode)
	if UserInputService.KeyboardEnabled then
		Win.keyboardBinds[featureName] = keyCode.Name
		Library.Config.keyboardBinds = Win.keyboardBinds
		Library:SaveConfig()
		return
	end
	if Win.bindingButtonRefs[featureName] then return end
	Win.quickBindCount = Win.quickBindCount + 1
	local border = Create("Frame", {
		Name = "Bind_" .. featureName,
		Size = UDim2.fromOffset(50, 50),
		Position = UDim2.fromOffset(14, 144 + (Win.quickBindCount - 1) * 58),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 41,
		Parent = Win.BindButtonHolder,
	})
	Create("UICorner", { CornerRadius = UDim.new(0, 10), Parent = border })
	local bindGradient = Create("UIGradient", {
		Rotation = Win.BorderGradient.Rotation,
		Color = Win.BorderGradient.Color,
		Parent = border,
	})
	table.insert(Win.bindGradients, bindGradient)
	AddThemeRefresher(function()
		if bindGradient.Parent then
			bindGradient.Color = Win.BorderGradient.Color
		end
		Win.refreshBindButtons()
	end)
	local button = Create("TextButton", {
		Size = UDim2.new(1, -6, 1, -6),
		Position = UDim2.fromOffset(3, 3),
		BackgroundColor3 = Library.Colors.background,
		BorderSizePixel = 0,
		TextColor3 = Library.Colors.text,
		TextSize = 9,
		TextWrapped = true,
		Font = Enum.Font.GothamBold,
		AutoButtonColor = false,
		ZIndex = 42,
		Parent = border,
	})
	Create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = button })
	Win.bindingButtonRefs[featureName] = button

	local dragging, wasDragged, dragInput, dragStart, bindStartPosition = false, false, nil, nil, nil
	Connect(button.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, wasDragged, dragInput = true, false, input
			dragStart, bindStartPosition = input.Position, border.Position
		end
	end)
	Connect(UserInputService.InputChanged, function(input)
		local isMouseMove = dragInput and dragInput.UserInputType == Enum.UserInputType.MouseButton1
			and input.UserInputType == Enum.UserInputType.MouseMovement
		if dragging and (input == dragInput or isMouseMove) then
			local delta = input.Position - dragStart
			if delta.Magnitude > 4 then wasDragged = true end
			local view = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800, 600)
			local x = math.clamp(bindStartPosition.X.Offset + delta.X, 4, view.X - 54)
			local y = math.clamp(bindStartPosition.Y.Offset + delta.Y, 4, view.Y - 54)
			border.Position = UDim2.fromOffset(x, y)
		end
	end)
	Connect(UserInputService.InputEnded, function(input)
		if input == dragInput then dragging, dragInput = false, nil end
	end)
	Connect(button.Activated, function()
		if not wasDragged then
			local setter = Win.featureToggleSetters[featureName]
			if setter then setter(not Win.featureStates[featureName]) end
		end
	end)
	Win.refreshBindButtons()
end

local function RemoveQuickBind(featureName)
	Win.keyboardBinds[featureName] = nil
	Library.Config.keyboardBinds = Win.keyboardBinds
	Library:SaveConfig()
	local button = Win.bindingButtonRefs[featureName]
	if button and button.Parent then button.Parent:Destroy() end
	Win.bindingButtonRefs[featureName] = nil
end


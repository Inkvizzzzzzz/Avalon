		Connect(action.Activated, function()
			if definition.callback then definition.callback(action) end
		end)
		api = {
			Button = action,
			SetText = function(self, text) action.Text = text end,
			SetColor = function(self, color) action.BackgroundColor3 = color end,
		}
	end
	return api
